# Copy to services/api/.env and apps/client/.env.local, then fill in real values.
# Never commit the copies — .gitignore excludes them.

# --- API (services/api/.env) ---
DATABASE_URL=postgresql://sweep:sweep@localhost:5433/sweep
TEST_DATABASE_URL=postgresql://sweep:sweep@localhost:5433/sweep_test
CORS_ORIGINS=["http://localhost:8081"]
# Login providers whose tokens the API accepts (slice 1 client work adds Clerk's values).
# AUTH_ISSUERS=[{"issuer": "https://<your-app>.clerk.accounts.dev", "jwks_url": "https://<your-app>.clerk.accounts.dev/.well-known/jwks.json"}]
# ANTHROPIC_API_KEY=        # added in slice 4

# --- Client (apps/client/.env.local) ---
# EXPO_PUBLIC_* values are bundled into the app and readable by anyone. No secrets.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Clerk Dashboard → API keys → Publishable key (public; safe in the bundle).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# The Clerk SECRET key never goes in the client.
