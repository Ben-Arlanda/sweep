# Copy to services/api/.env and apps/client/.env.local, then fill in real values.
# Never commit the copies — .gitignore excludes them.

# --- API (services/api/.env) ---
DATABASE_URL=postgresql://sweep:sweep@localhost:5432/sweep
CORS_ORIGINS=["http://localhost:8081"]
# ANTHROPIC_API_KEY=        # added in slice 4

# --- Client (apps/client/.env.local) ---
# EXPO_PUBLIC_* values are bundled into the app and readable by anyone. No secrets.
EXPO_PUBLIC_API_URL=http://localhost:8000
